# Hybrid Fraud Detection -- Environment Configuration
# Copy to .env and adjust values as needed.

# Ollama-compatible OpenAI API endpoint for LLM scoring
MODEL_ENDPOINT=http://ollama:11434/v1

# Model name served by Ollama
MODEL_NAME=qwen2.5:0.5b

# Set to true to use simulated LLM responses (no backend required)
DEMO_MODE=false

# Scoring weights (must sum to 1.0)
RULE_WEIGHT=0.6
LLM_WEIGHT=0.4

# URL the Gradio UI uses to reach the scorer API
SCORER_URL=http://localhost:8000
